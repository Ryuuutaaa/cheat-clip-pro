# CHEAT CLIP PRO — Environment Template
# ============================================================
# This app can run locally or deployed to a server.
# API keys for Gemini can be provided by users at runtime via the web interface.
#
# Get a free Gemini API key at: https://aistudio.google.com/
# ============================================================

# ── Gemini API (Optional Server Default) ──────────────────────
# If not set here, users must provide it in the web interface.
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Supadata API Keys (Tier 1 Fallback) ────────────────────────
# Supadata provides cloud-hosted residential IP proxying for YouTube transcripts.
# Multiple keys can be comma-separated or space-separated for automatic round-robin rotation.
# Get free keys (100 credits/mo each) at: https://supadata.ai/
# SUPADATA_API_KEYS=sd_key1,sd_key2,sd_key3

# ── Webshare Rotating Proxy (Tier 2-4 Fallback) ───────────────
# Per https://github.com/jdepoix/youtube-transcript-api#working-around-ip-bans-requestblocked-or-ipblocked-exception
# Webshare rotating proxies prevent YouTube datacenter IP bans (IpBlocked/RequestBlocked).
# Register at: https://www.webshare.io/
# WEBSHARE_USERNAME=your_username
# WEBSHARE_PASSWORD=your_password
# WEBSHARE_LOCATIONS=US,GB,DE
# WEBSHARE_RETRIES=5

# Alternatively, define the full Webshare proxy URL or generic proxy:
# WEBSHARE_PROXY=http://username-rotate:password@p.webshare.io:80
# PROXY_URL=http://username:password@proxy_host:port

# ── yt-dlp Player Clients (Optional) ──────────────────────────
# Which YouTube inner APIs yt-dlp is allowed to ask, in fallback order. The default works
# for most sessions. If downloads keep failing with bot verification even after saving
# fresh cookies, try another set here, e.g.:
#   YTDLP_PLAYER_CLIENTS=tv,web_safari
#   YTDLP_PLAYER_CLIENTS=ios,mweb
# YTDLP_PLAYER_CLIENTS=default,web_embedded,ios

# ── Cookies straight from a browser profile (Optional) ────────
# YouTube can refuse an exported cookies.txt with "The page needs to be reloaded" even when the
# file looks complete, while the live browser profile still works. Point yt-dlp at the browser
# instead of the exported file:
#   YTDLP_COOKIES_FROM_BROWSER=brave
#   YTDLP_COOKIES_FROM_BROWSER=chrome
#   YTDLP_COOKIES_FROM_BROWSER=firefox
# Close the browser first if reading its cookie database fails.

# ── Force IPv4 (Rarely needed) ───────────────────────────────
# Off by default. On networks whose IPv4 address YouTube challenges, forcing IPv4 turns a
# working download into "Sign in to confirm you're not a bot" — the same cookies and video
# succeed without it. Only enable this if IPv6 routing is broken on your machine.
# YTDLP_FORCE_IPV4=1

# ── Custom SSL Certificate Bundle (Optional) ─────────────────
# Path to custom CA bundle if running behind an SSL-inspecting proxy
# REQUESTS_CA_BUNDLE=/path/to/cacert.pem

# ── Subtitle Timing (Optional) ───────────────────────────────
# How word-level subtitle timing is produced:
#   auto     (default) keep the caption text, refine its timing with Whisper word timings
#   captions use the caption timings as-is
#   whisper  rely on Whisper word timing only
# SUBTITLE_TIMING=auto
# Whisper model size and forced language (default: base, language auto-detected).
# WHISPER_MODEL=base
# WHISPER_LANGUAGE=id

# ── Remote Download Throttling (Optional) ────────────────────
# Minimum seconds between YouTube/Drive downloads from this machine. Raising it lowers the chance
# of YouTube bot checks when clipping many clips in a row (default 3).
# YTDLP_MIN_INTERVAL_SEC=3

# ── CORS / Admin Access (Only needed when exposing the app) ──
# Extra origins allowed to call the API. Localhost is always allowed. This list is used for both
# CORS and the cross-origin guards on the admin, upload and cookie endpoints.
# ALLOWED_ORIGINS=https://myhost.example
# When set, the maintenance endpoints (update / restart / clear temp) require this token.
# Leave empty for a local desktop install, where they stay open.
# CHEAT_CLIP_API_KEY is accepted as a legacy alias for the same token.
# ADMIN_API_KEY=some_long_random_token

# ── Ports (Optional) ─────────────────────────────────────────
# Backend port. run.sh defaults to 8001, a bare `npm run dev` defaults to 8000; the Vite dev
# server proxies /api to whatever this resolves to, so keep launcher and proxy in sync.
# BACKEND_PORT=8001
# FRONTEND_PORT=5173
# VITE_PORT=5173   # accepted as an alias for FRONTEND_PORT

# ── Color Emoji Font Path (Optional) ─────────────────────────
# Path to a color emoji font (.ttf / .otf) such as NotoColorEmoji.ttf or seguiemj.ttf
# If not specified, cheat-clip-pro automatically uses backend/fonts/seguiemj.ttf or system fonts.
# EMOJI_FONT_PATH=/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf

